# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env nunca deve ser commitado (já está no .gitignore).

# ──────────────────────────────────────────────
# Django
# ──────────────────────────────────────────────
SECRET_KEY=troque-pela-sua-secret-key-django
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────────
# Banco de dados (opcional — padrão: SQLite)
# ──────────────────────────────────────────────
# DATABASE_URL=postgres://usuario:senha@localhost:5432/abo_goias

# ──────────────────────────────────────────────
# Armazenamento de arquivos (contratos DOCX/PDF, assinaturas)
# ──────────────────────────────────────────────
# Em produção (Railway) o filesystem do container é EFÊMERO: arquivos
# somem a cada deploy. Monte um Volume no serviço (ex.: /data) e aponte
# esta variável para ele. Em desenvolvimento pode deixar comentado
# (padrão: raiz do projeto).
# DJANGO_MEDIA_ROOT=/data/media

# ──────────────────────────────────────────────
# Celery — envio automático ao Dental Office e limpeza de sessões
# de assinatura (fila assíncrona, com retry)
# ──────────────────────────────────────────────
# Em produção, adicione o plugin Redis do Railway ao projeto — ele injeta
# REDIS_URL automaticamente nos serviços conectados, e essa variável já é
# usada como broker/result-backend por padrão (não precisa duplicar em
# CELERY_BROKER_URL, a menos que queira um Redis dedicado só para a fila).
# Em desenvolvimento, sem Redis local, os testes automatizados rodam as
# tarefas de forma síncrona (CELERY_TASK_ALWAYS_EAGER) — não é necessário
# configurar nada para `python manage.py test`.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
#
# Além do serviço web, é necessário criar no Railway:
#   1. Um serviço "worker", apontando para este mesmo repositório, com
#      Start Command: celery -A abo_goias worker --loglevel=info --concurrency=2
#   2. Um serviço "beat" (agendador), com
#      Start Command: celery -A abo_goias beat --loglevel=info
# Ambos devem ter as mesmas variáveis de ambiente do serviço web (banco de
# dados, Dental Office, Redis) — no Railway, use "Connect" para linkar as
# variáveis compartilhadas entre serviços do mesmo projeto.

# ──────────────────────────────────────────────
# Dental Office — Gestão de Laboratório
# ──────────────────────────────────────────────
# Credenciais obtidas junto ao suporte do Dental Office
DENTAL_CLIENT_ID=seu_client_id_aqui
DENTAL_SECRET=seu_secret_aqui
DENTAL_CLINIC_ID=1
DENTAL_USER_GROUP_ALUNO=8

# Token secreto para o endpoint de sincronização agendada (/laboratorio/sincronizar-agendado/)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Configure o mesmo valor no Railway Cron ou no serviço que vai chamar o endpoint.
DENTAL_SYNC_TOKEN=gere-um-token-secreto-aqui

# URLs (padrão aponta para o ambiente demo; altere para produção)
# DENTAL_AUTH_URL=https://demo.api.app.dentaloffice.com.br/v1/auth/tokens
# DENTAL_BASE_URL=https://demo.api.app.dentaloffice.com.br/v1

# Opções avançadas (raramente precisam ser alteradas)
# DENTAL_VERIFY_TLS=true
# DENTAL_TIMEOUT=30
# DENTAL_USE_PROXY=false

# ──────────────────────────────────────────────
# Eduq — Gestão de CME
# ──────────────────────────────────────────────
EDUQ_DOMINIO=seu_dominio_eduq
EDUQ_USUARIO=seu_usuario_eduq
EDUQ_SENHA=sua_senha_eduq

# URLs (padrão já configurado em settings.py)
# EDUQ_AUTH_URL=https://apisistema.eduqtecnologia.com.br/autenticacao/logar
# EDUQ_DATA_URL=https://apisistema.eduqtecnologia.com.br/emissao-consulta-personalizada/obter-dados
# EDUQ_CONSULTA_TURMAS_ID=4
# EDUQ_CONSULTA_DETALHES_TURMA_ID=5
# EDUQ_VERIFY_TLS=false
# EDUQ_TIMEOUT=30
# EDUQ_USE_PROXY=false
